{
  "name": "inkwell",
  "productName": "Inkwell",
  "version": "1.1.0",
  "description": "Inkwell \u2014 a beautiful, offline-first word processor for Mac, Windows, Linux, iOS, Android and the web.",
  "author": "Inkwell",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node scripts/smoke-test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "electron:dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "cap:sync": "npm run build && cap sync",
    "android:open": "npm run cap:sync && cap open android",
    "ios:open": "npm run cap:sync && cap open ios",
    "test:cloud": "node scripts/cloud-test.mjs"
  },
  "build": {
    "appId": "app.inkwell.editor",
    "productName": "Inkwell",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "inkwell",
        "name": "Inkwell Document",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Inkwell-${version}-mac.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Inkwell-${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Inkwell-${version}-linux-${arch}.${ext}",
      "maintainer": "Inkwell",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "docx": "^9.15.1",
    "dompurify": "^3.4.17",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "desktopName": "inkwell.desktop"
}
